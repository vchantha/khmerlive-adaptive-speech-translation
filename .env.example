POSTGRES_DB=khmerlive
POSTGRES_USER=khmerlive
POSTGRES_PASSWORD=change-me-postgres

# SILO is S3/MinIO API compatible. MINIO_* aliases remain supported by the app.
SILO_ROOT_USER=khmerlive-silo
SILO_ROOT_PASSWORD=change-me-silo-long-password
SILO_BUCKET=khmerlive
SILO_ENDPOINT=silo:9000
SILO_SECURE=true
SILO_CA_FILE=/etc/khmerlive/tls/ca.crt

# Backward-compatible aliases (optional; SILO_* takes precedence)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=

KAFKA_BOOTSTRAP_SERVERS=kafka:19093
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_LOCATION=/etc/khmerlive/tls/ca.crt
KAFKA_INGEST_TOPIC=khmerlive.ingest.requests
KAFKA_CHUNK_TOPIC=khmerlive.media.chunks
KAFKA_JOB_TOPIC=khmerlive.job.events
KAFKA_GROUP_ID=khmerlive-ingestion-worker
KAFKA_TLS_PASSWORD=change-me-kafka-tls

MAX_STREAM_SECONDS=3600
AUDIO_CHUNK_SECONDS=30
STREAM_SEGMENT_SECONDS=10

JUPYTERHUB_PASSWORD=change-me-jupyter
JUPYTERHUB_ADMIN_PASSWORD=change-me-admin

# Browser-facing HTTPS
HTTPS_PORT=8443
TLS_DAYS=825
