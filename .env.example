# Address other machines use to reach this host (LAN IP or DNS name).
# Used for Kafka's advertised listener, TLS certificate SANs, CORS and MLflow.
# After changing it, re-run `make tls` (or scripts/generate_tls.sh) and restart.
PUBLIC_HOST=localhost
# Optional extra comma-separated names/IPs for the TLS certificates.
EXTRA_TLS_SANS=

POSTGRES_DB=khmerlive
POSTGRES_USER=khmerlive
POSTGRES_PASSWORD=change-me-postgres

# SILO keeps MinIO-compatible credential environment variable names.
# Existing project .env files can keep these values unchanged.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-silo-long-password
MINIO_BUCKET=khmerlive
SILO_ENDPOINT=silo:9000
SILO_SECURE=true
SILO_CA_FILE=/etc/khmerlive/tls/ca.crt

KAFKA_BOOTSTRAP_SERVERS=kafka:19093
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_LOCATION=/etc/khmerlive/tls/ca.crt
KAFKA_INGEST_TOPIC=khmerlive.ingest.requests
KAFKA_CHUNK_TOPIC=khmerlive.media.chunks
KAFKA_JOB_TOPIC=khmerlive.job.events
KAFKA_GROUP_ID=khmerlive-ingestion-worker
KAFKA_TLS_PASSWORD=change-me-kafka-tls

KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me-kafka-ui

REDIS_PASSWORD=change-me-redis

MAX_STREAM_SECONDS=3600
AUDIO_CHUNK_SECONDS=30
STREAM_SEGMENT_SECONDS=10

JUPYTERHUB_PASSWORD=change-me-jupyter
